# Copy this file to .env.local (already gitignored via the *.local rule)
# and fill in the values from your Supabase project's
# Project Settings -> API page.
#
# Only the anon/publishable key belongs here -- it's safe to expose in
# browser code by design (Supabase enforces access via Row Level Security,
# not by keeping this key secret). Never put a service-role key in this
# project; it has no backend to keep one safe in.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
